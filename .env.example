# From https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Port the server listens on
PORT=3001

# true  = you can also play in a normal browser at http://localhost:3001 (handy for testing)
# false = Discord only (recommended on the VM)
ALLOW_GUESTS=true

# true = every shop item costs 0 coins (for testing skins). Keep false for real players.
FREE_SHOP=false

# Bug reports and feedback from the game (⚙ Settings → Contact the developer) arrive in your
# Discord DMs, sent by your app's bot. Discord Developer Portal -> your app -> Bot -> Reset Token,
# and invite the bot to a server you're in (bots can only DM people they share a server with).
# SUPPORT_USER_ID: your own Discord user id (Settings -> Advanced -> Developer Mode, then
# right-click your name -> Copy User ID). Without these, requests are kept in data/support.json.
DISCORD_BOT_TOKEN=
SUPPORT_USER_ID=

# Who can post announcements from inside the game (Inbox -> Post an announcement): Discord user
# ids, comma-separated. Leave empty to post only from the VM (bash scripts/announce.sh).
ADMIN_IDS=

# Real-money purchases through Discord (Developer Portal -> your app -> Monetization -> SKUs):
# each id here, then a colon, then that SKU's id. Gem packs and coffees are Consumable SKUs;
# `pass` is the Battle Pass, a monthly User Subscription. Needs DISCORD_BOT_TOKEN set too.
# SHOP_SKUS=pack-1:...,pack-2:...,pack-3:...,pack-4:...,coffee-1:...,pass:...
SHOP_SKUS=

# Chat translation with NVIDIA Riva Translate (build.nvidia.com key, the same kind Scottbott uses).
# Without it, Google's free endpoint and MyMemory translate instead.
NVIDIA_API_KEY=

# Better chat translation, both free: DeepL API Free (key ends in ":fx", deepl.com/pro-api) and
# Azure Translator on the F0 tier (key + the resource's region, e.g. uksouth).
DEEPL_API_KEY=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
