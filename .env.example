# From https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Port the server listens on
PORT=3001

# true  = you can also play in a normal browser at http://localhost:3001 (handy for testing)
# false = Discord only (recommended on the VM)
ALLOW_GUESTS=true

# true = every shop item costs 0 coins (for testing skins). Keep false for real players.
FREE_SHOP=false

# Bug reports and feedback from the game (⚙ Settings → Contact the developer) arrive in your
# Discord DMs, sent by your app's bot. Discord Developer Portal -> your app -> Bot -> Reset Token,
# and invite the bot to a server you're in (bots can only DM people they share a server with).
# SUPPORT_USER_ID: your own Discord user id (Settings -> Advanced -> Developer Mode, then
# right-click your name -> Copy User ID). Without these, requests are kept in data/support.json.
DISCORD_BOT_TOKEN=
SUPPORT_USER_ID=
